# Datos: ~490 MB descargados de nflverse. Se reconstruyen con `oracle refresh`.
data/raw/
data/processed/
out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.vercel/

# Artefactos generados que sí se versionan van en web/data/ (ver export_web_data.py),
# pero el JSON sin comprimir es intermedio y no aporta nada al diff.
web/data/model.json

# Sistema
.DS_Store
*.log

# El skill de UI/UX se versiona (3,6 MB, y sin él el repo no lo tiene), pero no
# sus tests ni sus fixtures: son del proyecto de origen, no de éste.
.claude/skills/*/scripts/tests/

# Capturas del arnés visual. Se regeneran con `node tools/screenshots.mjs`, son
# 40+ MB de PNG y no se pueden revisar en un diff. Se versiona el arnés, no su
# salida — al revés que `research/`, que sí se versiona porque no se puede
# reconstruir.
web/tools/shots/
